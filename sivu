<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HSL Bussiseuranta</title>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

    <style>
        html, body {
            margin: 0;
            height: 100%;
        }

        #map {
            width: 100%;
            height: 100%;
        }

        .info {
            position: absolute;
            top: 10px;
            left: 10px;
            z-index: 1000;
            background: white;
            padding: 10px;
            border-radius: 8px;
            font-family: Arial, sans-serif;
            box-shadow: 0 2px 6px rgba(0,0,0,.2);
        }
    </style>
</head>
<body>

<div class="info">
    <strong>HSL Bussiseuranta</strong><br>
    Päivittyy 10 sekunnin välein
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
const map = L.map('map').setView([60.1699, 24.9384], 11);

L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap'
}).addTo(map);

const vehicleMarkers = {};

async function loadVehicles() {

    // TÄHÄN tulee HSL/Digitransit-ajoneuvodatan haku.
    // Esimerkkidata testaukseen:

    const vehicles = [
        {
            id: "bus1",
            line: "550",
            lat: 60.205,
            lon: 24.838
        },
        {
            id: "bus2",
            line: "600",
            lat: 60.170,
            lon: 24.950
        }
    ];

    vehicles.forEach(vehicle => {

        if (!vehicleMarkers[vehicle.id]) {

            vehicleMarkers[vehicle.id] = L.marker([
                vehicle.lat,
                vehicle.lon
            ]).addTo(map);

        } else {

            vehicleMarkers[vehicle.id].setLatLng([
                vehicle.lat,
                vehicle.lon
            ]);
        }

        vehicleMarkers[vehicle.id]
            .bindPopup("Linja " + vehicle.line);
    });
}

loadVehicles();
setInterval(loadVehicles, 10000);
</script>

</body>
</html>
